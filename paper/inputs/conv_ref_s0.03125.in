# QUARZ paper case 'conv_ref_s0.03125' -- generated by make_decks.py from examples/pwfa_ion_motion.in
# Fig. conv: reference solution (stretched, steps x 1/32, N = 14617)
# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# ---------------------------------------------------------------------------
# PWFA with a strongly pinched, low-emittance witness and mobile hydrogen ions.
# Normalised units: n0, omega_p, c/omega_p, m_e c omega_p / e.   xi = t - z
# (e.g. n0 = 1e17 cm^-3: c/omega_p = 16.8 um, 1/omega_p = 56 fs, E0 = 30.4 GV/m)
# ---------------------------------------------------------------------------

# radial grid: 5e-4 near the axis (witness sigma_r = 0.01), 0.01 in the bubble
# sheath region, 0.05 far out.  Neighbouring cells differ by at most 5 %.
grid.type      = regions
grid.rmax      = 8.0
grid.regions     = 0.05:1.5625e-05  2.5:0.0003125  8.0:0.0015625      # paper case
grid.max_ratio = 1.05

xi.min           = -7.3      # paper case
xi.max  = 0
xi.step = 0.005

time.dt    = 10          # witness betatron period ~ 1250; ion motion needs dt <~ 10 (checked)
time.steps       = 0      # paper case
time.start = 0

pusher.ab_order  = 3
pusher.delta_min = 1e-3

# plasma: electrons + mobile hydrogen ions, uniform, column radius 7
plasma.species = electrons ions
plasma.radial  = uniform
plasma.rmax    = 7.0
# plasma.z_table = 0:0 200:1 1e6:1        # optional up-ramp (z:n pairs)
electrons.charge = -1
electrons.mass   = 1
electrons.ppc    = 4
ions.charge = 1
ions.mass   = 1836.15
ions.ppc    = 4
ions.mobile = 1

beams = driver witness

driver.charge     = -1
driver.n0         = 10
driver.sigma_r    = 0.3
driver.profile    = gaussian
driver.sigma_xi   = 1.0
driver.xi0        = -3.0
driver.gamma      = 20000
driver.espread    = 0.001
driver.emit_n     = 0.5
driver.nparticles = 400000

witness.charge     = -1
witness.n0         = 12500
witness.sigma_r    = 0.0100      # matched to the ion column for emit_n = 0.01, gamma = 2e4
witness.profile    = gaussian
witness.sigma_xi   = 0.1
witness.xi0        = -6.8
witness.gamma      = 20000
witness.espread    = 0.001
witness.emit_n     = 0.01
witness.nparticles = 200000

output.dir       = out_conv_ref_s0.03125      # paper case
output.every      = 10
output.beam_every = 25

# paper-case settings
driver.analytic  = 1
witness.analytic = 1
