\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Evolution of the pinched witness of Fig.~\ref {fig:maps} behind a rigid driver, with mobile hydrogen ions, on two uniform and two stretched grids ($\Delta t = 10$, $2\times 10^5$ witness particles). (a) Normalized emittance, (b) rms radius, both relative to their initial values. The 512-cell stretched grid coincides with the 967-cell one; the uniform grids overestimate the envelope oscillation.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:evolution}{{4}{7}{Evolution of the pinched witness of Fig.~\ref {fig:maps} behind a rigid driver, with mobile hydrogen ions, on two uniform and two stretched grids ($\Delta t = 10$, $2\times 10^5$ witness particles). (a) Normalized emittance, (b) rms radius, both relative to their initial values. The 512-cell stretched grid coincides with the 967-cell one; the uniform grids overestimate the envelope oscillation}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Bubble closure in the pinched-witness case of Fig.~\ref {fig:maps}, with the box extended to $\xi =12$ (single quasi-static solve). (a) $E_z$ on the axis at the closure: uniform grid $\Delta r = 0.005$; stretched grid ($h_0 = 5\times 10^{-4}$) with a cold plasma and with smoothing of the plasma sources, Eq.~\eqref  {eq:smooth}, $a = 0.005$. The cold spike reaches $-78$ at $\Delta \xi = 6.25\times 10^{-4}$. (b) Rms relative error of $E_z(0)$ and $\psi (0)$ behind the closure ($9.2<\xi <11.9$) versus $\Delta \xi $, with respect to $\Delta \xi = 6.25\times 10^{-4}$ of the same model. Triangles: $a = 0.005$ with axis cells $10^{-3}$ and $2.5\times 10^{-4}$ ($\Delta \xi = 0.00125$).}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:closure}{{5}{7}{Bubble closure in the pinched-witness case of Fig.~\ref {fig:maps}, with the box extended to $\xi =12$ (single quasi-static solve). (a) $E_z$ on the axis at the closure: uniform grid $\Delta r = 0.005$; stretched grid ($h_0 = 5\times 10^{-4}$) with a cold plasma and with smoothing of the plasma sources, Eq.~\eqref {eq:smooth}, $a = 0.005$. The cold spike reaches $-78$ at $\Delta \xi = 6.25\times 10^{-4}$. (b) Rms relative error of $E_z(0)$ and $\psi (0)$ behind the closure ($9.2<\xi <11.9$) versus $\Delta \xi $, with respect to $\Delta \xi = 6.25\times 10^{-4}$ of the same model. Triangles: $a = 0.005$ with axis cells $10^{-3}$ and $2.5\times 10^{-4}$ ($\Delta \xi = 0.00125$)}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Self-modulation of the AWAKE proton bunch after 6~m of plasma: QUARZ on uniform (3840 cells) and stretched (403 cells) radial grids, on CPUs and GPUs, compared with HiPACE++. (a) $E_z$ on the axis, with the head of the bunch at $\xi = 0$. (b) Phase of $E_z(r=0)$ and of the transverse force $F_r = E_r - B_\theta $ at $r = 0.1$ and $1\,k_p^{-1}$, from the zero crossings of the fields. Saturated lines: HiPACE++; light lines: the four QUARZ runs.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:awake}{{6}{8}{Self-modulation of the AWAKE proton bunch after 6~m of plasma: QUARZ on uniform (3840 cells) and stretched (403 cells) radial grids, on CPUs and GPUs, compared with HiPACE++. (a) $E_z$ on the axis, with the head of the bunch at $\xi = 0$. (b) Phase of $E_z(r=0)$ and of the transverse force $F_r = E_r - B_\theta $ at $r = 0.1$ and $1\,k_p^{-1}$, from the zero crossings of the fields. Saturated lines: HiPACE++; light lines: the four QUARZ runs}{figure.6}{}}
