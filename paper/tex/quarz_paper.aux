\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Error versus number of radial cells for the pinched witness of Fig.~\ref {fig:maps}: (a) ion density on the axis, (b) focusing field $W_r = E_r - B_\theta $ at $r=0.01$ (the witness radius), (c) $E_z$ on the axis. Open circles: uniform grids; squares: stretched grids with the same shape and all spacings scaled. The grids of Table~\ref {tab:pinch} are labelled. The flattening of the finest stretched points in (b) reflects the accuracy of the reference.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:convergence}{{3}{6}{Error versus number of radial cells for the pinched witness of Fig.~\ref {fig:maps}: (a) ion density on the axis, (b) focusing field $W_r = E_r - B_\theta $ at $r=0.01$ (the witness radius), (c) $E_z$ on the axis. Open circles: uniform grids; squares: stretched grids with the same shape and all spacings scaled. The grids of Table~\ref {tab:pinch} are labelled. The flattening of the finest stretched points in (b) reflects the accuracy of the reference}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Pinched witness with mobile hydrogen ions: maximum relative errors in the witness with respect to the reference of Fig.~\ref {fig:convergence}. $W_r = E_r - B_\theta $. Times per sweep of 1461 slices on 2 CPU cores.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:pinch}{{II}{6}{Pinched witness with mobile hydrogen ions: maximum relative errors in the witness with respect to the reference of Fig.~\ref {fig:convergence}. $W_r = E_r - B_\theta $. Times per sweep of 1461 slices on 2 CPU cores}{table.2}{}}
