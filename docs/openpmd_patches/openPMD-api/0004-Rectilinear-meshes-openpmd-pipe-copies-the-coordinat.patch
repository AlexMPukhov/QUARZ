     {
         {
-            Series series(file, Access::CREATE_LINEAR);
-            series.setIterationEncoding(IterationEncoding::variableBased);
+            // set after creation (basePath "/data/%T/"), or in the
+            // configuration (basePath "/data")
+            Series series = by_config
+                ? Series(
+                      file,
+                      Access::CREATE_LINEAR,
+                      R"({"iteration_encoding": "variable_based"})")
+                : Series(file, Access::CREATE_LINEAR);
+            if (!by_config)
+            {
+                series.setIterationEncoding(IterationEncoding::variableBased);
+            }
             for (uint64_t step = 0; step < 3; ++step)
             {
                 auto it = series.snapshots()[step];
@@ -223,7 +233,10 @@ auto rectilinear_meshes(std::string const &extension) -> void
 {
     if (extension == "bp" || extension == "bp4" || extension == "bp5")
     {
-        variable_based("../samples/rectilinear_variablebased." + extension);
+        variable_based(
+            "../samples/rectilinear_variablebased." + extension, false);
+        variable_based(
+            "../samples/rectilinear_variablebased_config." + extension, true);
     }
     for (auto const &[name, index] :
          {std::pair<std::string, uint64_t>{"rectilinear_groupbased", 100},
