From c303b4b5a8ce3a0e21b8584c28b4004cf7147f36 Mon Sep 17 00:00:00 2001
From: Alexander Pukhov <alex.m.pukhov@gmail.com>
Date: Fri, 16 Oct 2026 18:02:55 +0200
Subject: [PATCH 4/5] Rectilinear meshes: openpmd-pipe copies the coordinate
 data sets (and rewrites the references when the base path changes); base path
 of variable-based series without %T

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DRiRr7s6YoyWRd6EM8Zzbz
---
 src/Iteration.cpp                             |  7 ++++++
 .../python/openpmd_api/pipe/__main__.py       | 22 +++++++++++++++++++
 test/Files_SerialIO/rectilinear_meshes.cpp    | 21 ++++++++++++++----
 test/python/unittest/API/APITest.py           |  3 +--
 4 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/src/Iteration.cpp b/src/Iteration.cpp
index 6b832bc7..c0af7804 100644
--- a/src/Iteration.cpp
+++ b/src/Iteration.cpp
@@ -792,13 +792,20 @@ std::string Iteration::gridCoordinatesPath(std::string const &name) const
     std::string base = s.basePath();
     if (s.iterationEncoding() == IterationEncoding::variableBased)
     {
+        // e.g. "/data/%T/" or, as written by default for variable-based
+        // series, "/data": the iteration is the group itself
         base = auxiliary::replace_first(base, "%T/", "");
+        base = auxiliary::replace_first(base, "%T", "");
     }
     else
     {
         base = auxiliary::replace_first(
             base, "%T", std::to_string(getCachedIterationIndex()));
     }
+    if (base.empty() || base.back() != '/')
+    {
+        base += '/';
+    }
     return base + "gridCoordinates/" + name;
 }
 
diff --git a/src/binding/python/openpmd_api/pipe/__main__.py b/src/binding/python/openpmd_api/pipe/__main__.py
index df7a42bb..893741d6 100644
--- a/src/binding/python/openpmd_api/pipe/__main__.py
+++ b/src/binding/python/openpmd_api/pipe/__main__.py
@@ -481,6 +481,28 @@ class pipe:
         elif isinstance(src, io.Iteration):
             self.__copy(src.meshes, dest.meshes, current_path + "meshes/")
             self.__copy(src.particles, dest.particles, current_path + "particles/")
+            # coordinate data sets of rectilinear meshes, and their references
+            # (absolute paths, which differ e.g. in variable-based output)
+            if hasattr(src, "grid_coordinates") and len(src.grid_coordinates) > 0:
+                for key in src.grid_coordinates:
+                    self.__copy(
+                        src.grid_coordinates[key],
+                        dest.grid_coordinates[key],
+                        current_path + "gridCoordinates/" + key + "/",
+                    )
+                old = src.grid_coordinates_path("")
+                new = dest.grid_coordinates_path("")
+                if old != new:
+                    for _, mesh in dest.meshes.items():
+                        for obj in [mesh] + [c for _, c in mesh.items()]:
+                            if "gridCoordinates" in obj.attributes:
+                                obj.set_attribute(
+                                    "gridCoordinates",
+                                    [
+                                        new + p[len(old) :] if p.startswith(old) else p
+                                        for p in obj.get_attribute("gridCoordinates")
+                                    ],
+                                )
         elif is_container:
             for key in src:
                 self.__copy(src[key], dest[key], current_path + key + "/")
