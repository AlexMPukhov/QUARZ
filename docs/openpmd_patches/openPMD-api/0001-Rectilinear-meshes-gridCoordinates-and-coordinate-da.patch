+namespace rectilinear_meshes
+{
+using namespace openPMD;
+
+namespace
+{
+    // a stretched radial grid: cell centres and faces, fine at the axis
+    std::vector<double> const r_centres{0.25, 0.75, 1.5, 3.0, 6.0};
+    // outer faces of the cells: the same extent as the centres, since all
+    // components of a record have the same extent
+    std::vector<double> const r_faces{0.5, 1.0, 2.0, 4.0, 8.0};
+    constexpr size_t nz = 4;
+
+    void write(std::string const &file, uint64_t index)
+    {
+        Series series(file, Access::CREATE);
+        auto it = series.iterations[index];
+
+        // coordinate data sets
+        std::vector<double> centres = r_centres, faces = r_faces;
+        auto rc = it.gridCoordinates["r_centres"];
+        rc.resetDataset({Datatype::DOUBLE, {centres.size()}});
+        rc.storeChunk(centres, {0}, {centres.size()});
+        auto rf = it.gridCoordinates["r_faces"];
+        rf.resetDataset({Datatype::DOUBLE, {faces.size()}});
+        rf.storeChunk(faces, {0}, {faces.size()});
+
+        // scalar mesh on the cell centres; z regular
+        std::vector<double> rho(r_centres.size() * nz);
+        std::iota(rho.begin(), rho.end(), 0.0);
+        auto m = it.meshes["rho"];
+        m.setAxisLabels({"r", "z"});
+        m.setGridSpacing(std::vector<double>{0.5, 1.0});
+        m.setGridGlobalOffset({0.0, 10.0});
+        m.setGridCoordinates({it.gridCoordinatesPath("r_centres"), ""});
+        auto &s = m[RecordComponent::SCALAR];
+        s.setPosition(std::vector<double>{0.0, 0.5});
+        s.resetDataset({Datatype::DOUBLE, {r_centres.size(), nz}});
+        s.storeChunk(rho, {0, 0}, {r_centres.size(), nz});
+
+        // vector mesh with a staggered component (E_r on the faces)
+        auto E = it.meshes["E"];
+        E.setAxisLabels({"r", "z"});
+        E.setGridSpacing(std::vector<double>{0.5, 1.0});
+        E.setGridGlobalOffset({0.0, 10.0});
+        E.setGridCoordinates({it.gridCoordinatesPath("r_centres"), ""});
+        std::vector<double> er(r_faces.size() * nz, 1.0);
+        std::vector<double> ez(r_centres.size() * nz, 2.0);
+        auto Er = E["r"];
+        Er.setGridCoordinates({it.gridCoordinatesPath("r_faces"), ""});
+        Er.setPosition(std::vector<double>{0.0, 0.0});
+        Er.resetDataset({Datatype::DOUBLE, {r_faces.size(), nz}});
+        Er.storeChunk(er, {0, 0}, {r_faces.size(), nz});
+        auto Ez = E["z"];
+        Ez.setPosition(std::vector<double>{0.0, 0.5});
+        Ez.resetDataset({Datatype::DOUBLE, {r_centres.size(), nz}});
+        Ez.storeChunk(ez, {0, 0}, {r_centres.size(), nz});
+
+        // a regular mesh in the same iteration
+        auto B = it.meshes["B"];
+        B.setAxisLabels({"r", "z"});
+        B.setGridSpacing(std::vector<double>{0.5, 1.0});
+        B.setGridGlobalOffset({0.0, 10.0});
+        auto &b = B[RecordComponent::SCALAR];
+        b.setPosition(std::vector<double>{0.5, 0.5});
+        b.resetDataset({Datatype::DOUBLE, {r_centres.size(), nz}});
+        b.makeConstant(3.0);
+
+        it.close();
+    }
+
+    void read(std::string const &file, uint64_t index)
+    {
+        Series series(file, Access::READ_ONLY);
+        auto it = series.iterations[index];
+        std::string const prefix =
+            "/data/" + std::to_string(index) + "/gridCoordinates/";
+        REQUIRE(it.gridCoordinatesPath("r_faces") == prefix + "r_faces");
+
+        REQUIRE(it.gridCoordinates.size() == 2);
+        REQUIRE(it.gridCoordinates.contains("r_centres"));
+        REQUIRE(it.gridCoordinates.contains("r_faces"));
+        auto rc = it.gridCoordinates["r_centres"];
+        REQUIRE(rc.getExtent() == Extent{r_centres.size()});
+        auto rc_data = rc.loadChunk<double>();
+        auto rf_data = it.gridCoordinates["r_faces"].loadChunk<double>();
+        series.flush();
+        for (size_t i = 0; i < r_centres.size(); ++i)
+        {
+            REQUIRE(rc_data.get()[i] == r_centres[i]);
+        }
+        for (size_t i = 0; i < r_faces.size(); ++i)
+        {
+            REQUIRE(rf_data.get()[i] == r_faces[i]);
+        }
+
+        // the meshes are still read as before
+        REQUIRE(it.meshes.size() == 3);
+        auto m = it.meshes["rho"];
+        auto gc = m.gridCoordinates();
+        REQUIRE(gc.size() == 2);
+        REQUIRE(gc[0] == prefix + "r_centres");
+        REQUIRE(gc[1].empty());
+
+        auto coords = it.gridCoordinatesOf(m);
+        REQUIRE(coords.size() == 2);
+        REQUIRE(coords[0].has_value());
+        REQUIRE(!coords[1].has_value());
+        REQUIRE(coords[0]->getExtent()[0] == m.getExtent()[0]);
+
+        // staggered component: its own coordinates take precedence
+        auto E = it.meshes["E"];
+        auto cr = it.gridCoordinatesOf(E, "r");
+        REQUIRE(cr[0].has_value());
+        REQUIRE(cr[0]->getExtent()[0] == r_faces.size());
+        auto cz = it.gridCoordinatesOf(E, "z");
+        REQUIRE(cz[0]->getExtent()[0] == r_centres.size());
+
+        // regular mesh: no explicit coordinates
+        auto B = it.meshes["B"];
+        REQUIRE(!B.containsAttribute("gridCoordinates"));
+        REQUIRE(B.gridCoordinates() == std::vector<std::string>(2));
+        auto cb = it.gridCoordinatesOf(B);
+        REQUIRE(cb.size() == 2);
+        REQUIRE((!cb[0].has_value() && !cb[1].has_value()));
+        series.close();
+    }
+
+    void write_dangling(std::string const &file)
+    {
+        Series series(file, Access::CREATE);
+        auto it = series.iterations[0];
+        auto m = it.meshes["rho"];
+        m.setAxisLabels({"r"});
+        m.setGridSpacing(std::vector<double>{1.0});
+        m.setGridGlobalOffset({0.0});
+        m.setGridCoordinates({"/data/0/gridCoordinates/missing"});
+        auto &s = m[RecordComponent::SCALAR];
+        s.resetDataset({Datatype::DOUBLE, {3}});
+        s.makeConstant(1.0);
+        it.close();
+    }
+} // namespace
+
+auto rectilinear_meshes(std::string const &extension) -> void
+{
+    for (auto const &[name, index] :
+         {std::pair<std::string, uint64_t>{"rectilinear_groupbased", 100},
+          {"rectilinear_filebased_%T", 7}})
+    {
+        std::string const file = "../samples/" + name + "." + extension;
+        write(file, index);
+        read(file, index);
+    }
+
+    // a reference to a data set that does not exist is reported on reading
+    std::string const file = "../samples/rectilinear_dangling." + extension;
+    write_dangling(file);
+    Series series(file, Access::READ_ONLY);
+    auto it = series.iterations[0];
+    REQUIRE(it.gridCoordinates.empty());
+    REQUIRE_THROWS_AS(it.gridCoordinatesOf(it.meshes["rho"]), error::ReadError);
+}
+} // namespace rectilinear_meshes
