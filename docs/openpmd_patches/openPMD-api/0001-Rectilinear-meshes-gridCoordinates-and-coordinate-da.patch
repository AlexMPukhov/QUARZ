+/** @brief  Coordinate data sets of rectilinear meshes.
+ *
+ * One-dimensional data sets with the positions of the data points along an
+ * axis of a mesh with explicit (non-equidistant) coordinates. They live in the
+ * group <code>gridCoordinates/</code> of an iteration
+ * (<code>basePath + "gridCoordinates/" + name</code>) and are referenced by
+ * the mesh attribute <code>gridCoordinates</code>, see
+ * Mesh::setGridCoordinates(). Values are in grid units, i.e. multiplied by the
+ * gridUnitSI of the axis they belong to, and relative to its
+ * gridGlobalOffset. One data set may be referenced by several meshes.
+ *
+ * @see https://github.com/openPMD/openPMD-standard/issues/142
+ */
+class GridCoordinates : public Container<RecordComponent>
+{
+public:
+    void visitHierarchy(HierarchyVisitor &v, bool recursive) override;
+};
