+#!/usr/bin/env python
+"""
+This file is part of the openPMD-api.
+
+A rectilinear mesh: a thetaMode field on a stretched radial grid (fine at the
+axis, coarse outside) and a regular z grid. The radial positions of the data
+points are stored once per iteration as a coordinate data set and referenced
+by the mesh attribute gridCoordinates.
+
+Copyright 2026 openPMD contributors
+Authors: Alexander Pukhov
+License: LGPLv3+
+"""
+
+import numpy as np
+import openpmd_api as io
+
+if __name__ == "__main__":
+    series = io.Series(
+        "../samples/3c_write_rectilinear_serial_py.h5", io.Access.create_linear
+    )
+
+    num_modes = 2
+    num_fields = 1 + (num_modes - 1) * 2
+    N_r, N_z = 40, 100
+
+    # radial nodes: spacing 0.01 at the axis, growing geometrically by 10 %
+    r = np.concatenate([[0.0], np.cumsum(0.01 * 1.1 ** np.arange(N_r - 1))])
+
+    it = series.snapshots()[0]
+    r_nodes = it.grid_coordinates["r_nodes"]
+    r_nodes.reset_dataset(io.Dataset(r.dtype, r.shape))
+    r_nodes.store_chunk(r)
+
+    E = it.meshes["E"]
+    E.geometry = io.Geometry.thetaMode
+    E.geometry_parameters = "m={0};imag=+".format(num_modes)
+    E.axis_labels = ["r", "z"]
+    # informative along r (the smallest spacing), regular along z
+    E.grid_spacing = [0.01, 0.05]
+    E.grid_global_offset = [0.0, 0.0]
+    E.grid_unit_SI = 1e-6
+    E.grid_coordinates = [it.grid_coordinates_path("r_nodes"), ""]
+
+    # all components on the same nodes: position 0 along r
+    E_z_data = np.exp(-(r[None, :, None] ** 2)) * np.cos(
+        0.3 * np.arange(N_z)[None, None, :] + np.arange(num_fields)[:, None, None]
+    )
+    E_z = E["z"]
+    E_z.position = [0.0, 0.5]
+    E_z.reset_dataset(io.Dataset(E_z_data.dtype, E_z_data.shape))
+    E_z.store_chunk(E_z_data)
+
+    it.close()
+    series.close()
+
+    # read back: the coordinates of each axis, or None for a regular axis
+    read = io.Series(
+        "../samples/3c_write_rectilinear_serial_py.h5", io.Access.read_only
+    )
+    rit = read.snapshots()[0]
+    r_coords, z_coords = rit.grid_coordinates_of(rit.meshes["E"])
+    r_read = r_coords.load_chunk()
+    read.flush()
+    print(
+        "E: r has explicit coordinates {0:g} ... {1:g}, z is regular: {2}".format(
+            r_read[0], r_read[-1], z_coords is None
+        )
+    )
+    read.close()
