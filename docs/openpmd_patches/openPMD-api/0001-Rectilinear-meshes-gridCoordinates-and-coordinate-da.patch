+void Iteration::readGridCoordinates()
+{
+    Parameter<Operation::OPEN_PATH> pOpen;
+    pOpen.path = "gridCoordinates";
+    IOHandler()->enqueue(IOTask(&gridCoordinates, pOpen));
+    gridCoordinates.readAttributes(ReadMode::FullyReread);
+
+    internal::EraseStaleEntries<decltype(gridCoordinates)> map{gridCoordinates};
+
+    Parameter<Operation::LIST_DATASETS> dList;
+    IOHandler()->enqueue(IOTask(&gridCoordinates, dList));
+    IOHandler()->flush(internal::defaultFlushParams);
+
+    Parameter<Operation::OPEN_DATASET> dOpen;
+    for (auto const &name : *dList.datasets)
+    {
+        RecordComponent &rc = map[name];
+        dOpen.name = name;
+        IOHandler()->enqueue(IOTask(&rc, dOpen));
+        IOHandler()->flush(internal::defaultFlushParams);
+        rc.setWritten(false, Attributable::EnqueueAsynchronously::No);
+        rc.resetDataset(Dataset(*dOpen.dtype, *dOpen.extent));
+        rc.setWritten(true, Attributable::EnqueueAsynchronously::No);
+        try
+        {
+            rc.read();
+        }
+        catch (error::ReadError const &err)
+        {
+            std::cerr << "Cannot read coordinate data set '" << name
+                      << "' and will skip it due to read error:\n"
+                      << err.what() << std::endl;
+            map.forget(name);
+        }
+    }
+}
+
+std::string Iteration::gridCoordinatesPath(std::string const &name) const
+{
+    Series s = retrieveSeries();
+    std::string base = s.basePath();
+    if (s.iterationEncoding() == IterationEncoding::variableBased)
+    {
+        base = auxiliary::replace_first(base, "%T/", "");
+    }
+    else
+    {
+        base = auxiliary::replace_first(
+            base, "%T", std::to_string(getCachedIterationIndex()));
+    }
+    return base + "gridCoordinates/" + name;
+}
+
+std::vector<std::optional<RecordComponent>>
+Iteration::gridCoordinatesOf(Mesh const &mesh, std::string const &component)
+{
+    std::vector<std::string> paths;
+    if (!component.empty() && mesh.contains(component) &&
+        mesh.at(component).containsAttribute("gridCoordinates"))
+    {
+        paths = mesh.at(component)
+                    .getAttribute("gridCoordinates")
+                    .get<std::vector<std::string>>();
+    }
+    else if (mesh.containsAttribute("gridCoordinates"))
+    {
+        paths = mesh.gridCoordinates();
+    }
+    else
+    {
+        return std::vector<std::optional<RecordComponent>>(
+            mesh.axisLabels().size());
+    }
+    std::string const prefix = gridCoordinatesPath("");
+    std::vector<std::optional<RecordComponent>> res;
+    res.reserve(paths.size());
+    for (auto const &path : paths)
+    {
+        if (path.empty())
+        {
+            res.emplace_back(std::nullopt);
+            continue;
+        }
+        if (!auxiliary::starts_with(path, prefix) ||
+            !gridCoordinates.contains(path.substr(prefix.size())))
+        {
+            throw error::ReadError(
+                error::AffectedObject::Attribute,
+                error::Reason::NotFound,
+                std::nullopt,
+                "gridCoordinates: '" + path +
+                    "' is not a coordinate data set of this iteration (" +
+                    prefix + "...).");
+        }
+        res.emplace_back(gridCoordinates.at(path.substr(prefix.size())));
+    }
+    return res;
+}
