+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License and the GNU Lesser General Public License
+ * for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * and the GNU Lesser General Public License along with openPMD-api.
+ * If not, see <http://www.gnu.org/licenses/>.
+ */
+#include <openPMD/openPMD.hpp>
+
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+
+using namespace openPMD;
+
+/* A rectilinear mesh: a thetaMode field on a stretched radial grid (fine at
+ * the axis, coarse outside) and a regular z grid. The radial positions of
+ * the data points are stored once per iteration as a coordinate data set and
+ * referenced by the mesh attribute gridCoordinates.
+ */
+int main()
+{
+    Series series = Series(
+        "../samples/3c_write_rectilinear_serial.h5", Access::CREATE_LINEAR);
+
+    unsigned int const num_modes = 2u;
+    unsigned int const num_fields = 1u + (num_modes - 1u) * 2u;
+    size_t const N_r = 40, N_z = 100;
+
+    // radial nodes: spacing 0.01 at the axis, growing geometrically by 10 %
+    std::vector<double> r(N_r);
+    double dr = 0.01;
+    for (size_t i = 1; i < N_r; ++i, dr *= 1.1)
+        r[i] = r[i - 1] + dr;
+
+    auto it = series.snapshots()[0];
+    auto r_nodes = it.gridCoordinates["r_nodes"];
+    r_nodes.resetDataset({determineDatatype<double>(), {N_r}});
+    r_nodes.storeChunk(r, {0}, {N_r});
+
+    auto E = it.meshes["E"];
+    E.setGeometry(Mesh::Geometry::thetaMode);
+    E.setGeometryParameters("m=" + std::to_string(num_modes) + ";imag=+");
+    E.setAxisLabels({"r", "z"});
+    // informative along r (the smallest spacing), regular along z
+    E.setGridSpacing(std::vector<double>{0.01, 0.05});
+    E.setGridGlobalOffset({0.0, 0.0});
+    E.setGridUnitSI(1e-6);
+    E.setGridCoordinates({it.gridCoordinatesPath("r_nodes"), ""});
+
+    // all components on the same nodes: position 0 along r
+    std::vector<double> E_z_data(num_fields * N_r * N_z);
+    for (size_t m = 0; m < num_fields; ++m)
+        for (size_t i = 0; i < N_r; ++i)
+            for (size_t k = 0; k < N_z; ++k)
+                E_z_data[(m * N_r + i) * N_z + k] =
+                    std::exp(-r[i] * r[i]) * std::cos(0.3 * k + m);
+    auto E_z = E["z"];
+    E_z.setPosition(std::vector<double>{0.0, 0.5});
+    E_z.resetDataset({determineDatatype<double>(), {num_fields, N_r, N_z}});
+    E_z.storeChunk(E_z_data, {0, 0, 0}, {num_fields, N_r, N_z});
+
+    it.close();
+    series.close();
+
+    // read back: the coordinates of each axis, or nothing for a regular axis
+    Series read("../samples/3c_write_rectilinear_serial.h5", Access::READ_ONLY);
+    auto rit = read.snapshots()[0];
+    auto coords = rit.gridCoordinatesOf(rit.meshes["E"]);
+    auto r_read = coords.at(0)->loadChunk<double>();
+    read.flush();
+    std::cout << "E: " << coords.size() << " axes, r has explicit coordinates "
+              << r_read.get()[0] << " ... " << r_read.get()[N_r - 1]
+              << ", z is regular: " << !coords.at(1).has_value() << std::endl;
+    read.close();
+    return 0;
+}
