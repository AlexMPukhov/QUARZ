new file mode 100644
index 0000000..1e63749
--- /dev/null
+++ b/tests/test_rectilinear.py
@@ -0,0 +1,171 @@
+"""
+This test file is part of the openPMD-viewer.
+
+It tests meshes with explicit, non-equidistant coordinates along some axes
+(rectilinear meshes: the attribute `gridCoordinates` names a 1D coordinate
+data set per axis, proposed for openPMD 2.0, openPMD-standard issue #142).
+The files are written with h5py, so that the test does not depend on the
+writer; they are read with every available backend.
+
+Copyright 2026, openPMD-viewer contributors
+Authors: Alexander Pukhov
+License: 3-Clause-BSD-LBNL
+"""
+import h5py
+import numpy as np
+import pytest
+
+from openpmd_viewer import OpenPMDTimeSeries
+from openpmd_viewer.openpmd_timeseries.data_reader import available_backends
+
+# stretched radial nodes (fine at the axis) and a regular z axis
+R_NODES = np.concatenate([[0.0], np.cumsum(0.1 * 1.25 ** np.arange(11))])
+NZ, DZ, Z0 = 16, 0.5, 3.0
+UNIT = 1e-6   # gridUnitSI
+
+
+def fields(r, z):
+    """modes m = 0, cos 1, sin 1 of a test field, (3, Nr, Nz)"""
+    rr, zz = np.meshgrid(r, z, indexing='ij')
+    f0 = np.exp(-rr**2) * np.cos(zz)
+    return np.array([f0, rr * np.exp(-rr**2), 0.5 * rr * np.sin(zz)])
+
+
+def write_file(path, form):
+    """thetaMode mesh E (component z) on R_NODES, and a 2D cartesian mesh rho
+    with a rectilinear x axis; `form` = "dataset" (openPMD 2.0 proposal) or
+    "attribute" (interim form, geometry "other" + "thetaMode;...")"""
+    z = Z0 + DZ * np.arange(NZ)
+    with h5py.File(path, 'w') as f:
+        f.attrs['openPMD'] = np.bytes_('1.1.0')
+        f.attrs['openPMDextension'] = np.uint32(0)
+        f.attrs['basePath'] = np.bytes_('/data/%T/')
+        f.attrs['meshesPath'] = np.bytes_('meshes/')
+        f.attrs['iterationEncoding'] = np.bytes_('fileBased')
+        f.attrs['iterationFormat'] = np.bytes_('data%T.h5')
+        it = f.create_group('/data/10')
+        it.attrs['time'] = 0.0
+        it.attrs['dt'] = 1.0
+        it.attrs['timeUnitSI'] = 1.0
+        if form == 'dataset':
+            it['gridCoordinates/r'] = R_NODES
+            it['gridCoordinates/x'] = R_NODES
+        E = it.create_group('meshes/E')
+        if form == 'dataset':
+            E.attrs['geometry'] = np.bytes_('thetaMode')
+            E.attrs['geometryParameters'] = np.bytes_('m=2;imag=+')
+            E.attrs['gridCoordinates'] = np.array(
+                [b'/data/10/gridCoordinates/r', b''])
+        else:
+            E.attrs['geometry'] = np.bytes_('other')
+            E.attrs['geometryParameters'] = np.bytes_('thetaMode;m=2;imag=+')
+            E.attrs['gridCoordinates_r'] = R_NODES
+        for key, val in [('axisLabels', np.array([b'r', b'z'])),
+                         ('dataOrder', np.bytes_('C')),
+                         ('gridSpacing', np.array([0.1, DZ])),
+                         ('gridGlobalOffset', np.array([0.0, Z0])),
+                         ('gridUnitSI', UNIT),
+                         ('unitDimension', np.zeros(7)),
+                         ('timeOffset', 0.0)]:
+            E.attrs[key] = val
+        Ez = E.create_dataset('z', data=fields(R_NODES, z))
+        Ez.attrs['position'] = np.array([0.0, 0.0])
+        Ez.attrs['unitSI'] = 1.0
+        if form == 'dataset':
+            rho = it.create_dataset(
+                'meshes/rho', data=fields(R_NODES, z)[0])
+            for key, val in [('geometry', np.bytes_('cartesian')),
+                             ('axisLabels', np.array([b'x', b'z'])),
+                             ('dataOrder', np.bytes_('C')),
+                             ('gridSpacing', np.array([0.1, DZ])),
+                             ('gridGlobalOffset', np.array([0.0, Z0])),
+                             ('gridUnitSI', UNIT),
+                             ('unitDimension', np.zeros(7)),
+                             ('timeOffset', 0.0),
+                             ('position', np.array([0.0, 0.0])),
+                             ('unitSI', 1.0),
+                             ('gridCoordinates',
+                              np.array([b'/data/10/gridCoordinates/x', b'']))]:
+                rho.attrs[key] = val
+
+
+def backends_for(form):
+    out = []
+    for b in available_backends:
+        if b == 'openpmd-api' and form == 'dataset':
+            import openpmd_api
+            if not hasattr(openpmd_api.Iteration, 'grid_coordinates'):
+                continue   # this openPMD-api cannot read coordinate data sets
+        out.append(b)
+    return out
+
+
+@pytest.mark.parametrize('form', ['dataset', 'attribute'])
+def test_rectilinear_thetamode(tmp_path, form):
+    write_file(str(tmp_path / 'data00000010.h5'), form)
+    z = Z0 + DZ * np.arange(NZ)
+    ref = fields(R_NODES, z)
+    r_mirror = np.concatenate([-R_NODES[::-1], R_NODES]) * UNIT
+    for backend in backends_for(form):
+        ts = OpenPMDTimeSeries(str(tmp_path), backend=backend)
+        assert ts.fields_metadata['E']['geometry'] == 'thetaMode'
+
+        # the plane theta = 0: m = 0 + cos 1, mirrored below the axis
+        F, info = ts.get_field('E', 'z', iteration=10, m='all', theta=0.)
+        assert info.rectilinear == ['r']
+        np.testing.assert_allclose(info.r, r_mirror)
+        np.testing.assert_allclose(info.z, z * UNIT)
+        assert np.isclose(info.dr, 0.1 * UNIT)
+        np.testing.assert_allclose(F[len(R_NODES):, :], ref[0] + ref[1])
+        np.testing.assert_allclose(F[:len(R_NODES), :],
+                                   (ref[0] - ref[1])[::-1, :])
+        edges = info.get_edges('r')
+        assert len(edges) == len(info.r) + 1
+        assert np.all(np.diff(edges) >= 0)
+
+        # slicing across r at the axis picks the node r = 0
+        F1, info1 = ts.get_field('E', 'z', iteration=10, m=0, theta=0.,
+                                 slice_across='r', slice_relative_position=0.)
+        np.testing.assert_allclose(F1, ref[0][0])
+        assert info1.rectilinear == []
+
+        # 3D reconstruction on the nodes: exact at y = 0, x = r_node
+        F3, info3 = ts.get_field('E', 'z', iteration=10, m='all', theta=None)
+        assert set(info3.rectilinear) == {'x', 'y'}
+        iy = len(R_NODES)          # y = +0
+        np.testing.assert_allclose(F3[len(R_NODES):, iy, :], ref[0] + ref[1])
+        # at x = 0, y = r_node: m = 0 + sin 1
+        ix = len(R_NODES)
+        np.testing.assert_allclose(F3[ix, len(R_NODES):, :], ref[0] + ref[2])
+
+        # the grid range follows the coordinates
+        grid_size, grid_range = ts.data_reader.get_grid_parameters(
+            10, ts.avail_fields, ts.fields_metadata)
+        assert np.isclose(grid_range['r'][1], R_NODES[-1] * UNIT)
+
+
+def test_rectilinear_cartesian(tmp_path):
+    write_file(str(tmp_path / 'data00000010.h5'), 'dataset')
+    z = Z0 + DZ * np.arange(NZ)
+    ref = fields(R_NODES, z)[0]
+    for backend in backends_for('dataset'):
+        ts = OpenPMDTimeSeries(str(tmp_path), backend=backend)
+        F, info = ts.get_field('rho', iteration=10)
+        assert info.rectilinear == ['x']
+        np.testing.assert_allclose(info.x, R_NODES * UNIT)
+        np.testing.assert_allclose(F, ref)
+        # slice in x at the middle of the coordinate range, not of the index
+        F1, info1 = ts.get_field('rho', iteration=10, slice_across='x',
+                                 slice_relative_position=0.)
+        i_mid = np.argmin(np.abs(R_NODES - 0.5 * R_NODES[-1]))
+        np.testing.assert_allclose(F1, ref[i_mid])
+        assert info1.rectilinear == []
+
+
+def test_rectilinear_plot(tmp_path):
+    matplotlib = pytest.importorskip('matplotlib')
+    matplotlib.use('Agg')
+    write_file(str(tmp_path / 'data00000010.h5'), 'dataset')
+    ts = OpenPMDTimeSeries(str(tmp_path), backend='h5py')
+    ts.get_field('E', 'z', iteration=10, plot=True)
+    ts.get_field('rho', iteration=10, plot=True)
