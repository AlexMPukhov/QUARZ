+def get_grid_coordinates(series, iteration, field, component):
+    """
+    Explicit coordinates of the rectilinear axes of a mesh record component
+    (attribute `gridCoordinates`: per axis, in the order of `axisLabels`,
+    an empty string for a regular axis or the absolute path of a coordinate
+    data set of the iteration; set on the component, or on the record).
+    Also reads the interim attributes `gridCoordinates_<label>` (explicit
+    positions stored in an attribute, e.g. older QUARZ files).
+
+    Parameters
+    ----------
+    series: openpmd_api.Series
+    iteration: openpmd_api.Iteration
+    field: openpmd_api.Mesh
+    component: openpmd_api.Mesh_Record_Component
+
+    Returns
+    -------
+    A dictionary {axis index: 1darray}, the axis index in the order of the
+    array (i.e. after reverting the axes for Fortran data order), with the
+    positions in grid units, relative to gridGlobalOffset. Empty for a
+    regular mesh.
+    """
+    labels = list(field.axis_labels)
+    if 'gridCoordinates' in component.attributes:
+        paths = component.get_attribute('gridCoordinates')
+    elif 'gridCoordinates' in field.attributes:
+        paths = field.get_attribute('gridCoordinates')
+    else:
+        paths = None
+    coords = {}
