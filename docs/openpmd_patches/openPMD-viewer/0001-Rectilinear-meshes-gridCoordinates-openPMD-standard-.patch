+def get_grid_coordinates( dfile, group, dset ):
+    """
+    Explicit coordinates of the rectilinear axes of a mesh record component
+    (attribute `gridCoordinates`: per axis, in the order of `axisLabels`,
+    an empty string for a regular axis or the absolute path of a 1D data set
+    with the positions of the data points; set on the component, or on the
+    record). Also reads the interim attributes `gridCoordinates_<label>`
+    (explicit positions stored in an attribute, e.g. older QUARZ files).
+
+    Parameters
+    ----------
+    dfile: an h5py.File object
+    group: an h5py.Group (the mesh record)
+    dset: an h5py.Dataset (the record component)
+
+    Returns
+    -------
+    A dictionary {axis index: 1darray}, the axis index in the order of the
+    array (i.e. after reverting the axes for Fortran data order), with the
+    positions in grid units, relative to gridGlobalOffset. Empty for a
+    regular mesh.
+    """
+    labels = [ x.decode() if isinstance(x, bytes) else str(x)
+               for x in group.attrs['axisLabels'] ]
+    paths = dset.attrs.get('gridCoordinates', group.attrs.get('gridCoordinates'))
+    coords = {}
+    for i, label in enumerate(labels):
+        c = None
+        if paths is not None:
+            path = paths[i]
+            path = path.decode() if isinstance(path, bytes) else str(path)
+            if path != '':
+                c = np.asarray( dfile[path][()], dtype=float )
+        if c is None:
+            interim = dset.attrs.get('gridCoordinates_' + label,
+                                     group.attrs.get('gridCoordinates_' + label))
+            if interim is not None:
+                c = np.asarray( interim, dtype=float )
+        if c is not None:
+            coords[i] = c
+    order = group.attrs['dataOrder']
+    order = order.decode() if isinstance(order, bytes) else str(order)
+    if order == 'F':
+        n = len(labels)
+        coords = { n - 1 - i: c for i, c in coords.items() }
+    return coords
