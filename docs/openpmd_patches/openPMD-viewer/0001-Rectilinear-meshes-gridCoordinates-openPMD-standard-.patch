+def slice_index(n_cells, slice_relative_position, coords=None):
+    """
+    Index of the data point at which to slice an axis.
+
+    `slice_relative_position` is between -1 (lower edge of the box) and 1
+    (upper edge). On a regular axis it is converted with the number of
+    cells; on a rectilinear axis (explicit coordinates `coords`, which are
+    not equidistant) it refers to the coordinate range, and the data point
+    nearest to that position is returned.
+    """
+    if coords is not None:
+        coords = np.asarray(coords, dtype=float)
+        target = coords[0] + 0.5 * (slice_relative_position + 1.) * \
+            (coords[-1] - coords[0])
+        return int(np.argmin(np.abs(coords - target)))
+    i_cell = int( 0.5 * (slice_relative_position + 1.) * n_cells )
+    i_cell = max( i_cell, 0 )
+    return min( i_cell, n_cells - 1 )
+
+
+def construct_3d_from_circ_rectilinear( F3d, Fcirc, x_array, y_array, modes,
+    r_nodes, coord_order ):
+    """
+    Reconstruct the field from a quasi-cylindrical simulation (`Fcirc`) on
+    the explicit radial nodes `r_nodes` (rectilinear radial axis), as a 3D
+    cartesian array (`F3d`): linear interpolation in r between the nodes,
+    constant beyond the last node (as `construct_3d_from_circ`).
+    """
+    r_nodes = np.asarray(r_nodes, dtype=float)
+    nr = len(r_nodes)
+    X, Y = np.meshgrid(x_array, y_array, indexing='ij')
+    R = np.sqrt(X**2 + Y**2)
+    # interpolation weights between the nodes ir - 1 and ir
+    ir = np.clip(np.searchsorted(r_nodes, R), 1, nr - 1) if nr > 1 \
+        else np.zeros(R.shape, dtype=int)
+    if nr > 1:
+        s1 = np.clip((R - r_nodes[ir - 1]) / (r_nodes[ir] - r_nodes[ir - 1]),
+                     0., 1.)
+    else:
+        s1 = np.ones(R.shape)
+    s0 = 1. - s1
+    with np.errstate(invalid='ignore', divide='ignore'):
+        expItheta = np.where(R > 0, (X + 1.j * Y) / np.where(R > 0, R, 1.),
+                             1. + 0.j)
+    if coord_order is RZorder.mrz:
+        F = np.moveaxis(Fcirc, 1, 0)   # (r, modes, z)
+    elif coord_order is RZorder.mzr:
+        F = np.moveaxis(Fcirc, 2, 0)   # (r, modes, z)
+    else:
+        raise Exception(order_error_msg)
+    lo = np.maximum(ir - 1, 0)
+    proj = s0[..., None, None] * F[lo] + s1[..., None, None] * F[ir]
+    for mode in modes:
+        if mode == 0:
+            F3d[:, :, :] += proj[:, :, 0, :]
+        else:
+            e = expItheta**mode
+            F3d[:, :, :] += proj[:, :, 2 * mode - 1, :] * e.real[..., None] \
+                + proj[:, :, 2 * mode, :] * e.imag[..., None]
