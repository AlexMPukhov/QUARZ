     def _reconstruct_theta_mode_component(self, values, theta_info, thetas):
@@ -651,13 +699,93 @@ class openPMDReader(VTKPythonAlgorithmBase):
 
         return vector.reshape((-1, vector.shape[-1]), order="C")
 
+    def _coordinate_data_set(self, itr, path):
+        """Load a coordinate data set referenced by the gridCoordinates
+        attribute (absolute path in the file). Uses openPMD-api if it supports
+        coordinate data sets (Iteration.grid_coordinates), otherwise reads HDF5
+        files directly with h5py. Returns None if neither is possible."""
+        if hasattr(itr, "grid_coordinates"):
+            prefix = itr.grid_coordinates_path("")
+            if path.startswith(prefix) and path[len(prefix) :] in itr.grid_coordinates:
+                rc = itr.grid_coordinates[path[len(prefix) :]]
+                values = rc.load_chunk()
+                self._series.flush()
+                return np.asarray(values, dtype=np.float64)
+            return None
+        import os
+
+        filename = os.path.join(
+            os.path.dirname(self._filename),
+            _expand_iteration_pattern(self._pattern, self._current_iteration),
+        )
+        if not filename.endswith((".h5", ".hdf5")):
+            return None
+        try:
+            import h5py
+        except ImportError:
+            return None
+        try:
+            with h5py.File(filename, "r") as f:
+                return np.asarray(f[path][...], dtype=np.float64)
+        except (OSError, KeyError):
+            return None
+
+    def _grid_coordinates(self, itr, var):
+        """Explicit positions of the data points along the axes of a
+        rectilinear mesh (openPMD 2.0: attribute gridCoordinates, one path of a
+        1D coordinate data set per axis, "" for a regular axis; set on the
+        record or on a component). Also reads the interim attributes
+        gridCoordinates_<axis label> of openPMD 1.1 files (QUARZ).
+
+        Returns a list with one entry per axis (in the order of axisLabels):
+        None for a regular axis, else the positions in grid units relative to
+        gridGlobalOffset."""
+        labels = [_string_attribute(label) for label in var.axis_labels]
+        first = None
+        for _, component in var.items():  # scalar records have one component
+            first = component
+            break
+        paths = None
+        for owner in (first, var):
+            if owner is not None and paths is None:
+                paths = _get_attribute(owner, "gridCoordinates")
+        coords = []
+        for i, label in enumerate(labels):
+            c = None
+            if paths is not None and i < len(paths) and _string_attribute(paths[i]) != "":
+                c = self._coordinate_data_set(itr, _string_attribute(paths[i]))
+                if c is None and not self._warned_coordinates:
+                    print_error(
+                        "openPMD mesh with explicit grid coordinates (gridCoordinates): "
+                        "they need an openPMD-api with coordinate data sets, or h5py for "
+                        "HDF5 files. Falling back to the regular gridSpacing."
+                    )
+                    self._warned_coordinates = True
+            if c is None:
+                for owner in (first, var):
+                    if owner is None:
+                        continue
+                    value = _get_attribute(owner, "gridCoordinates_" + label)
+                    if value is not None:
+                        c = np.asarray(value, dtype=np.float64)
+                        break
+            coords.append(c)
+        return coords
+
     def _find_array(self, itr, name):
         var = itr.meshes[name]
+        unit = var.grid_unit_SI
+        offset = np.array(var.grid_global_offset) * unit
+        coords = [
+            None if c is None else offset[i] + c * unit
+            for i, c in enumerate(self._grid_coordinates(itr, var))
+        ]
         return (
             var,
-            np.array(var.grid_spacing) * var.grid_unit_SI,
-            np.array(var.grid_global_offset) * var.grid_unit_SI,
-            var.geometry == io.Geometry.thetaMode,
+            np.array(var.grid_spacing) * unit,
+            offset,
+            _is_theta_mode(var),
+            coords,
         )
 
     def _get_num_particles(self, itr, species):
@@ -765,6 +893,7 @@ class openPMDReader(VTKPythonAlgorithmBase):
         data_time = self._get_update_time(timeInfo)
