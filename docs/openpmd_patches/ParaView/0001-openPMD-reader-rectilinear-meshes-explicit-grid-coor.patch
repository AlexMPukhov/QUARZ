 1 file changed, 185 insertions(+), 14 deletions(-)

diff --git a/Wrapping/Python/paraview/algorithms/openpmd.py b/Wrapping/Python/paraview/algorithms/openpmd.py
index 6a9ec37..eb4c496 100644
--- a/Wrapping/Python/paraview/algorithms/openpmd.py
+++ b/Wrapping/Python/paraview/algorithms/openpmd.py
@@ -93,6 +93,47 @@ def _parse_theta_mode_parameters(mesh, stored_modes):
 
     return num_modes, imag_sign
 
+def _get_attribute(obj, name, default=None):
+    """Attribute of an openPMD-api object, or default if it is not set."""
+    try:
+        if name in obj.attributes:
+            return obj.get_attribute(name)
+    except Exception:
+        pass
+    return default
+
+
+def _geometry_parameters(mesh):
+    params = getattr(mesh, "geometry_parameters", "")
+    if callable(params):
+        params = params()
+    return _string_attribute(params)
+
+
+def _is_theta_mode(mesh):
+    """thetaMode mesh, also in the interim marking of rectilinear thetaMode
+    meshes in openPMD 1.1 files: geometry "other" with geometryParameters
+    "thetaMode;..." (written by QUARZ and GEM-PIC-RZ)."""
+    if mesh.geometry == io.Geometry.thetaMode:
+        return True
+    if mesh.geometry == io.Geometry.other:
+        return _geometry_parameters(mesh).strip().startswith("thetaMode")
+    return False
+
+
+def _expand_iteration_pattern(pattern, index):
+    """File name of iteration `index` in a file-based series pattern
+    (%T or %0<n>T); the pattern itself for a group- or variable-based series."""
+    import re
+
+    match = re.search(r"%(0\d+)?T", pattern)
+    if match is None:
+        return pattern
+    width = match.group(1)
+    number = ("%" + width + "d") % index if width else str(index)
+    return pattern[: match.start()] + number + pattern[match.end() :]
+
+
