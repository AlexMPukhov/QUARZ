# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# low-power laser in a matched parabolic channel: spot size stays w0
grid.type = regions
grid.rmax = 20
grid.regions = 2:0.02 8:0.05 20:0.2
xi.min = -12
xi.max = 0
xi.step = 0.02
time.dt = 5
time.steps = 60
plasma.species = electrons
electrons.ppc = 2
my_constants.w0 = 3
plasma.density(x,y,z) = "1 + 4*(x^2+y^2)/w0^4"
beams =
laser.k0 = 10
laser.a0 = 0.02
laser.w0 = 3
laser.L0 = 2
laser.xi0 = -5
output.every = 0
output.dir = out_laser_ch
