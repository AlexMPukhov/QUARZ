# field ionization of dilute H and He by the field of a rigid electron beam (ions immobile: clean reference)
units.n0_cm3 = 1e17
grid.type = uniform
grid.rmax = 4
grid.dr = 0.01
xi.min = 0
xi.max = 8
xi.step = 0.005
time.dt = 0
time.steps = 0
plasma.species = electrons gas hyd
electrons.ppc = 0
gas.element = He
gas.density = 1e-4
gas.ppc = 16
gas.mobile = 0
gas.ionization.impact = 0
beams = driver
driver.analytic = 1
driver.n0 = 25
driver.sigma_r = 0.5
driver.sigma_xi = 1
driver.xi0 = 3
driver.gamma = 20000
output.dir = out_ion_adk
output.every = 1
hyd.element = H
hyd.density = 1e-4
hyd.ppc = 16
hyd.mobile = 0
