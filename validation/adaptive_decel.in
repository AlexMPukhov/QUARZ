# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# Adaptive time step with a decelerating witness (inside the rigid driver, gamma 50 -> ~20)
grid.type = regions
grid.rmax = 8
grid.regions = 0.5:0.005 2.5:0.02 8:0.1
grid.max_ratio = 1.05
xi.min = -6
xi.max = 0
xi.step = 0.01
time.adaptive = 1
time.nt_per_betatron = 32
time.t_end = 100
plasma.species = electrons
electrons.ppc = 4
beams = driver witness
driver.n0 = 10
driver.sigma_r = 0.3
driver.sigma_xi = 1.0
driver.xi0 = -3
driver.gamma = 20000
driver.nparticles = 200000
driver.rigid = 1
witness.n0 = 0.01
witness.sigma_r = 0.05
witness.sigma_xi = 0.05
witness.xi0 = -4
witness.gamma = 50
witness.emit_n = 0.001
witness.nparticles = 20000
beams.xi_shape = ngp
output.dir = out_adapt_dec
output.every = 0
