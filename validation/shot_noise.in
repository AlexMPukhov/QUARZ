# Shot noise of the beam (section 25): a long proton bunch (Arthur's case 1 parameters: 400 GeV, sigma_r = 200 um,
# eps_n = 2.2 um, n0 = 2.965e16 cm^-3 -> c/omega_p = 30.87 um) drifting 1 m in vacuum (no plasma particles).
# The noise power of sum_i w_i K(r_i) exp(i k xi_i) over k must equal that of the real protons (Poisson) for every
# radial kernel K, at the start and after the transverse mixing of 1 m of drift (shot_check.py).
units.n0_cm3 = 2.965e16
grid.type = regions
grid.rmax = 40
grid.regions = 26:0.1 40:0.5
grid.max_ratio = 1.05
xi.min = 0
xi.max = 5000
xi.step = 1
time.dt = 3240
time.steps = 10
plasma.species = electrons
electrons.ppc = 0
beams = p
p.charge = 1
p.mass = 1836.15
p.profile = parsed
p.density(x,y,xi) = "if(xi > 100 && xi < 4900, 3.15e-4*exp(-(x^2+y^2)/(2*6.479^2))*(if(xi < 300, sin(pi*(xi-100)/400)^2, if(xi > 4700, sin(pi*(4900-xi)/400)^2, 1))), 0)"
p.xi_range = 100 4900
p.r_max = 26
p.gamma = 427.3
p.ux_std = 0.0110
p.uy_std = 0.0110
output.dir = out_shot
output.every = 0
output.beam_every = 10
