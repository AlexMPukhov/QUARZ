# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# Coulomb scattering in a pure ion channel: emittance growth of a matched witness,
# d eps_n / dt = D / sqrt(2 gamma) with D = kappa Z^2 n_i L_i (Kirby et al.)
grid.type = regions
grid.rmax = 4
grid.regions = 0.3:0.002 4:0.02
grid.max_ratio = 1.05
xi.min = -2
xi.max = 0
xi.step = 0.02
time.dt = 10
time.steps = 200
units.n0_cm3 = 1e17
plasma.species = ions
ions.charge = 1
ions.mass = 1836
ions.mobile = 0
beams = witness
witness.n0 = 1e-6
witness.sigma_r = 0.021147
witness.sigma_xi = 0.1
witness.xi0 = -1
witness.gamma = 1000
witness.emit_n = 0.01
witness.nparticles = 100000
witness.scattering = 1
scattering.factor = 1e5
scattering.coulomb_log_ions = 10
output.dir = out_scat_ch
output.every = 0
