# beam impact ionization of dilute He, Ne, Ar, Kr, Xe (built-in Bethe data, Rieke & Prepejchal 1972) by
# a rigid singly charged beam at gamma = 3.39, the minimum of the primary ionization cross-section
units.n0_cm3 = 1e16
grid.type = uniform
grid.rmax = 4
grid.dr = 0.02
xi.min = 0
xi.max = 100
xi.step = 0.1
time.dt = 0
time.steps = 0
plasma.species = electrons he ne ar kr xe
electrons.ppc = 0
he.element = He
ne.element = Ne
ar.element = Ar
kr.element = Kr
xe.element = Xe
he.density = 1e-6
ne.density = 1e-6
ar.density = 1e-6
kr.density = 1e-6
xe.density = 1e-6
he.ppc = 32
ne.ppc = 32
ar.ppc = 32
kr.ppc = 32
xe.ppc = 32
he.mobile = 0
ne.mobile = 0
ar.mobile = 0
kr.mobile = 0
xe.mobile = 0
he.ionization.field = 0
ne.ionization.field = 0
ar.ionization.field = 0
kr.ionization.field = 0
xe.ionization.field = 0
he.ionization.nsplit = 2000
ne.ionization.nsplit = 2000
ar.ionization.nsplit = 2000
kr.ionization.nsplit = 2000
xe.ionization.nsplit = 2000
beams = b
b.analytic = 1
b.charge = 1
b.mass = 1836.15
b.n0 = 40
b.sigma_r = 1
b.sigma_xi = 15
b.xi0 = 50
b.gamma = 3.39
output.dir = out_ion_gases
output.every = 1
