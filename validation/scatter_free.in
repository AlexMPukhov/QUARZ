# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# Coulomb scattering: a weak zero-emittance witness in a uniform plasma (no wake to speak of):
# <p_x^2> grows as D t with D = kappa (Z^2 n_i L_i + n_e L_e), kappa = k_p r_e * scattering.factor
grid.type = regions
grid.rmax = 6
grid.regions = 1:0.01 6:0.05
grid.max_ratio = 1.05
xi.min = -2
xi.max = 0
xi.step = 0.02
time.dt = 5
time.steps = 20
units.n0_cm3 = 1e17
plasma.species = electrons
electrons.ppc = 2
beams = witness
witness.n0 = 1e-8
witness.sigma_r = 0.05
witness.sigma_xi = 0.1
witness.xi0 = -1
witness.gamma = 1000
witness.emit_n = 0
witness.nparticles = 100000
witness.scattering = 1
scattering.factor = 1e6
scattering.coulomb_log_ions = 10
scattering.coulomb_log_electrons = 10
output.dir = out_scat_free
output.every = 0
output.beam_every = 20
