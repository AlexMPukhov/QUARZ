# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# Witness energy gain in a static blowout (rigid driver)
grid.type = regions
grid.rmax = 8
grid.regions = 0.5:0.0025 2.5:0.01 8:0.05
grid.max_ratio = 1.05
xi.min = -10
xi.max = 0
xi.step = 0.005
time.dt = 10
time.steps = 20
plasma.species = electrons
electrons.ppc = 4
beams = driver witness
driver.n0 = 10
driver.sigma_r = 0.3
driver.sigma_xi = 1.0
driver.xi0 = -3
driver.gamma = 20000
driver.nparticles = 500000
driver.rigid = 1
witness.n0 = 0.01
witness.sigma_r = 0.05
witness.sigma_xi = 0.02
witness.xi0 = -7
witness.gamma = 1000
witness.emit_n = 0.001
witness.nparticles = 20000
output.dir = out_gain
output.every = 0
