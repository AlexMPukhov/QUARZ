# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# MPI test: low-energy beam slipping backwards through several ranks; mobile ions; m = 1
modes = 1
solver.picard = 2
grid.type = regions
grid.rmax = 5
grid.regions = 1.0:0.01 5:0.05
grid.max_ratio = 1.05
xi.min = -8
xi.max = 0
xi.step = 0.02
time.dt = 2
time.steps = 24
plasma.species = electrons ions
ions.charge = 1
ions.mass = 100
ions.mobile = 1
ions.ppc = 2
ions.ntheta = 8
electrons.ppc = 2
electrons.ntheta = 8
beams = driver slow
driver.n0 = 2
driver.sigma_r = 0.4
driver.sigma_xi = 0.8
driver.xi0 = -2
driver.gamma = 200
driver.emit_n = 0.1
driver.x_slope = -0.01
driver.nparticles = 100000
slow.n0 = 0.5
slow.sigma_r = 0.3
slow.sigma_xi = 0.4
slow.xi0 = -3
slow.gamma = 5
slow.espread = 0.05
slow.emit_n = 0.02
slow.x0 = 0.1
slow.nparticles = 50000
output.every = 4
output.beam_every = 6
output.beam_slices = 40
