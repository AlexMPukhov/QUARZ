# delta electrons of beam impact ionization: dilute Xe, rigid beam (protons at gamma = 3.39; electrons:
# b.mass = 1, b.charge = -1), the electrons born in the sweep are written to born_xe_*.txt
units.n0_cm3 = 1e20
grid.type = uniform
grid.rmax = 4
grid.dr = 0.02
xi.min = 0
xi.max = 100
xi.step = 0.1
time.dt = 1
time.steps = 1
plasma.species = electrons xe
electrons.ppc = 0
xe.element = Xe
xe.density = 1e-6
xe.ppc = 16
xe.mobile = 0
xe.ionization.field = 0
xe.ionization.nsplit = 100000
xe.impact.secondary_energy = 1
xe.ionization.born_dump = 1
beams = b
b.analytic = 1
b.charge = 1
b.mass = 1836.15
b.n0 = 1e-3
b.sigma_r = 1
b.sigma_xi = 15
b.xi0 = 50
b.gamma = 3.39
output.dir = out_delta
output.every = 1
