# converted to the xi = z - t convention (beam head at the largest xi) by tools/convert_deck.py
# laser diffraction in (almost) vacuum: w(t) = w0 sqrt(1 + ((t - zf)/zR)^2), zR = k0 w0^2/2
grid.type = uniform
grid.rmax = 14
grid.dr = 0.05
xi.min = -10
xi.max = 0
xi.step = 0.05
time.dt = 2
time.steps = 40
plasma.species = electrons
electrons.density = 1e-9
electrons.ppc = 1
beams =
laser.k0 = 20
laser.a0 = 0.1
laser.w0 = 2
laser.L0 = 1.5
laser.xi0 = -5
laser.focus = 40
output.every = 0
output.dir = out_laser_vac
